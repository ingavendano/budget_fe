{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/budget_fe/browser",
  "installCommand": "npm ci --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://146.235.238.78:8080/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://146.235.238.78:8080/auth/:path*"
    },
    {
      "source": "/((?!env\\.js$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/env.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
